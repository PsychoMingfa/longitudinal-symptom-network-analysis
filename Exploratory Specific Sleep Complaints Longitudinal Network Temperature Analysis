to_numeric_safe <- function(x) {
  suppressWarnings(readr::parse_number(as.character(x), na = c("", "NA", "N/A", "missing")))
}

edge_count <- function(adj_matrix) sum(adj_matrix[upper.tri(adj_matrix)] != 0)

extract_pattern_from_model <- function(model, items, tol = 1e-8) {
  omega_list <- psychonetrics::getmatrix(model, "omega")
  if (is.list(omega_list)) omega_mat <- omega_list[[1]] else omega_mat <- omega_list
  omega_mat <- as.matrix(omega_mat)
  if (is.null(rownames(omega_mat))) rownames(omega_mat) <- items
  if (is.null(colnames(omega_mat))) colnames(omega_mat) <- items
  omega_mat <- omega_mat[items, items, drop = FALSE]
  pattern <- 1L * (abs(omega_mat) > tol)
  diag(pattern) <- 0L
  pattern <- 1L * ((pattern + t(pattern)) > 0)
  diag(pattern) <- 0L
  dimnames(pattern) <- list(items, items)
  pattern
}

fit_group_model <- function(group_data, items, pattern, domain_name, group_name) {
  model_data <- group_data %>%
    transmute(time = as.integer(time), across(all_of(items), as.integer)) %>%
    drop_na(all_of(items)) %>%
    arrange(time)
  
  invalid_flag <- vapply(model_data[items], function(x) any(!(x %in% c(-1L, 1L))), logical(1))
  if (any(invalid_flag)) {
    stop(domain_name, " / ", group_name, " has values outside {-1, 1}: ", paste(names(invalid_flag)[invalid_flag], collapse = ", "))
  }
  
  cat("Fitting [", domain_name, " / ", group_name, "]; free edges = ", edge_count(pattern), "\n", sep = "")
  psychonetrics::Ising(
    data      = model_data,
    vars      = items,
    groups    = "time",
    omega     = pattern,
    equal     = c("omega", "tau"),
    missing   = "listwise",
    storedata = TRUE,
    identify  = TRUE
  ) %>% psychonetrics::runmodel()
}

extract_group_temperature <- function(group_models, domain_name) {
  purrr::imap_dfr(group_models, function(model, group_name) {
    beta_list <- psychonetrics::getmatrix(model, "beta")
    beta_vector <- vapply(beta_list, function(x) mean(as.numeric(x), na.rm = TRUE), numeric(1))
    tibble(
      Domain      = domain_name,
      SleepGroup  = group_name,
      Wave        = paste0("T", seq_along(beta_vector)),
      Beta        = beta_vector,
      Temperature = 1 / beta_vector
    )
  })
}

run_stratified_bootstrap <- function(long_data, items, pattern, domain_name, output_dir,
                                     R = 1000, ncores = 2, seed = 1, batch_size = 50) {
  wide_by_group <- long_data %>%
    select(ID, SleepGroup, time, all_of(items)) %>%
    pivot_wider(
      id_cols     = c(ID, SleepGroup),
      names_from  = time,
      values_from = all_of(items),
      names_glue  = "{.value}.{time}"
    ) %>%
    split(.$SleepGroup)
  
  group_names_vec <- five_group_levels
  group_n_vec <- vapply(wide_by_group[group_names_vec], nrow, integer(1))
  cat("\n[", domain_name, "] Participant ID count per stratum:\n", sep = "")
  print(group_n_vec)
  
  col_names <- as.vector(outer(paste0("T", 2:5), group_names_vec, function(w, g) paste(g, w, sep = "___")))
  result_matrix <- matrix(NA_real_, nrow = R, ncol = length(col_names), dimnames = list(NULL, col_names))
  
  boot_items <- items
  boot_pattern <- pattern
  boot_groups <- group_names_vec
  boot_wide_list <- wide_by_group
  boot_seed <- seed
  
  worker_fun <- function(iter_index) {
    set.seed(boot_seed + iter_index)
    sampled_list <- lapply(boot_groups, function(g) {
      curr_wide <- boot_wide_list[[g]]
      n_subj <- nrow(curr_wide)
      idx <- sample.int(n_subj, n_subj, replace = TRUE)
      boot_wide <- curr_wide[idx, , drop = FALSE]
      boot_wide$BootID <- paste(g, seq_len(n_subj), sep = "_")
      boot_wide$ID <- NULL
      boot_long <- tidyr::pivot_longer(
        boot_wide,
        cols          = -c(BootID, SleepGroup),
        names_to      = c(".value", "time"),
        names_pattern = "(Q\\d+)\\.(\\d+)"
      )
      boot_long$time <- as.integer(boot_long$time)
      keep_row <- rowSums(!is.na(boot_long[, boot_items, drop = FALSE])) > 0
      boot_long <- boot_long[keep_row, , drop = FALSE]
      boot_long[, c("time", boot_items), drop = FALSE]
    })
    names(sampled_list) <- boot_groups
    
    out_vec <- rep(NA_real_, length(boot_groups) * 4)
    names(out_vec) <- as.vector(outer(paste0("T", 2:5), boot_groups, function(w, g) paste(g, w, sep = "___")))
    
    for (g in boot_groups) {
      model_data <- sampled_list[[g]]
      model_g <- tryCatch({
        psychonetrics::Ising(
          data      = model_data,
          vars      = boot_items,
          groups    = "time",
          omega     = boot_pattern,
          equal     = c("omega", "tau"),
          missing   = "listwise",
          storedata = TRUE,
          identify  = TRUE
        ) %>% psychonetrics::runmodel()
      }, error = function(e) NULL)
      
      if (!is.null(model_g)) {
        b_list <- psychonetrics::getmatrix(model_g, "beta")
        b_vec <- vapply(b_list, function(x) mean(as.numeric(x), na.rm = TRUE), numeric(1))
        t_vec <- (1 / b_vec)[-1]
        out_vec[paste(g, paste0("T", 2:5), sep = "___")] <- t_vec
      }
    }
    out_vec
  }
  
  cl <- parallel::makeCluster(ncores)
  on.exit(parallel::stopCluster(cl), add = TRUE)
  parallel::clusterEvalQ(cl, { library(psychonetrics); library(tidyr) })
  parallel::clusterExport(cl, c("boot_items", "boot_pattern", "boot_groups", "boot_wide_list", "boot_seed"), envir = environment())
  
  num_batches <- ceiling(R / batch_size)
  for (b in seq_len(num_batches)) {
    batch_indices <- ((b - 1) * batch_size + 1):min(b * batch_size, R)
    batch_results <- parallel::parLapply(cl, batch_indices, worker_fun)
    result_matrix[batch_indices, ] <- do.call(rbind, batch_results)
    saveRDS(list(t = result_matrix[1:max(batch_indices), , drop = FALSE], R = max(batch_indices)),
            file.path(output_dir, paste0("Exploratory_sleep_", domain_name, "_bootstrap_partial.rds")))
  }
  
  final_output <- list(t = result_matrix, R = R)
  saveRDS(final_output, file.path(output_dir, paste0("Exploratory_sleep_", domain_name, "_bootstrap_final.rds")))
  succ <- sum(complete.cases(result_matrix))
  cat(domain_name, ": ", succ, "/", R, " complete bootstrap iterations.\n", sep = "")
  final_output
}

summarize_group_bootstrap_ci <- function(point_estimates, bootstrap_result) {
  boot_matrix <- as.matrix(bootstrap_result$t)
  point_estimates %>%
    mutate(
      key = paste(SleepGroup, Wave, sep = "___"),
      Bootstrap_CI_lower = NA_real_,
      Bootstrap_CI_upper = NA_real_,
      Successful_bootstrap = NA_integer_
    ) %>%
    group_by(SleepGroup, Wave) %>%
    group_modify(~ {
      curr_row <- .x
      curr_key <- curr_row$key[1]
      if (curr_row$Wave[1] == "T1") {
        curr_row$Successful_bootstrap <- bootstrap_result$R
        return(curr_row)
      }
      if (curr_key %in% colnames(boot_matrix)) {
        vals <- boot_matrix[, curr_key]
        vals <- vals[is.finite(vals)]
        curr_row$Successful_bootstrap <- length(vals)
        if (length(vals) >= 20) {
          ci <- quantile(vals, c(0.025, 0.975), names = FALSE, type = 7)
          curr_row$Bootstrap_CI_lower <- ci[1]
          curr_row$Bootstrap_CI_upper <- ci[2]
        }
      }
      curr_row
    }) %>%
    ungroup() %>%
    select(-key)
}

calculate_delta_delta_table <- function(point_estimates, bootstrap_result, domain_name, wave_focus = c("T2", "T3", "T4", "T5")) {
  boot_mat <- as.matrix(bootstrap_result$t)
  ref_group <- "No complaint"
  focal_groups <- setdiff(five_group_levels, ref_group)
  
  point_lookup <- setNames(point_estimates$Temperature, paste(point_estimates$SleepGroup, point_estimates$Wave, sep = "___"))
  
  records <- list()
  for (focal in focal_groups) {
    comp_name <- paste(focal, "vs", ref_group)
    for (w in wave_focus) {
      ref_T1  <- 1.0; focal_T1 <- 1.0
      ref_w   <- point_lookup[[paste(ref_group, w, sep = "___")]]
      focal_w <- point_lookup[[paste(focal, w, sep = "___")]]
      pe <- (focal_w - focal_T1) - (ref_w - ref_T1)
      
      col_ref   <- paste(ref_group, w, sep = "___")
      col_focal <- paste(focal, w, sep = "___")
      
      boot_diff <- (boot_mat[, col_focal] - 1.0) - (boot_mat[, col_ref] - 1.0)
      boot_valid <- boot_diff[is.finite(boot_diff)]
      n_valid <- length(boot_valid)
      
      if (n_valid >= 20) {
        ci <- quantile(boot_valid, c(0.025, 0.975), names = FALSE, type = 7)
        ci_lower <- ci[1]; ci_upper <- ci[2]
        p_val <- min(1, 2 * min((sum(boot_valid <= 0) + 1) / (n_valid + 1), (sum(boot_valid >= 0) + 1) / (n_valid + 1)))
        ci_excludes_zero <- (ci_lower > 0) || (ci_upper < 0)
        boot_se <- sd(boot_valid)
      } else {
        ci_lower <- NA_real_; ci_upper <- NA_real_; p_val <- NA_real_; ci_excludes_zero <- NA; boot_se <- NA_real_
      }
      
      records[[length(records) + 1]] <- tibble(
        Domain               = domain_name,
        Comparison           = comp_name,
        FocalGroup           = focal,
        ReferenceGroup       = ref_group,
        Wave                 = w,
        DeltaDeltaT          = pe,
        Bootstrap_SE         = boot_se,
        CI_lower             = ci_lower,
        CI_upper             = ci_upper,
        Raw_bootstrap_p      = p_val,
        Successful_bootstrap = n_valid,
        CI_excludes_zero     = ci_excludes_zero
      )
    }
  }
  bind_rows(records)
}

diagnose_divergence <- function(all_delta_delta) {
  wave_order <- paste0("T", 2:5)
  all_delta_delta %>%
    mutate(Wave = factor(Wave, levels = wave_order)) %>%
    arrange(Domain, Comparison, Wave) %>%
    group_by(Domain, Comparison) %>%
    group_modify(~ {
      dat <- .x %>% arrange(Wave)
      significant <- dat$CI_excludes_zero
      significant[is.na(significant)] <- FALSE
      direction <- sign(dat$DeltaDeltaT)
      
      first_wave <- if (any(significant)) {
        as.character(dat$Wave[which(significant)[1]])
      } else {
        NA_character_
      }
      
      persistent_wave <- NA_character_
      for (j in seq_along(wave_order)) {
        later <- j:length(wave_order)
        if (all(significant[later]) && length(unique(direction[later])) == 1) {
          persistent_wave <- wave_order[j]
          break
        }
      }
      
      tibble(
        First_wave_CI_excludes_zero = first_wave,
        Persistent_from_wave        = persistent_wave,
        T5_DeltaDeltaT              = dat$DeltaDeltaT[as.character(dat$Wave) == "T5"],
        T5_direction                = ifelse(dat$DeltaDeltaT[as.character(dat$Wave) == "T5"] < 0, "Lower relative temperature", "Higher relative temperature")
      )
    }) %>%
    ungroup()
}

format_ci_text <- function(ci_lower, ci_upper) {
  if (is.na(ci_lower) || is.na(ci_upper)) return("NA to NA")
  paste0(sprintf("%.3f", ci_lower), " to ", sprintf("%.3f", ci_upper))
}

format_p_text <- function(p_val) {
  if (is.na(p_val)) return("NA")
  if (p_val < 0.001) return("<0.001")
  paste0("=", sprintf("%.3f", p_val))
}

