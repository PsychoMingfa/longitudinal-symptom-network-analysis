# 4. LOAD AND PREPARE DATA
# ==============================================================================
file_paths <- file.path(data_dir, wave_files)
if (!all(file.exists(file_paths))) {
  stop("Missing wave data files:\n", paste(file_paths[!file.exists(file_paths)], collapse = "\n"))
}

wave_list <- lapply(file_paths, readxl::read_excel)
names(wave_list) <- wave_levels

required_items <- unique(c(dep_items, anx_items, sleep_items))
for (wave_index in seq_along(wave_list)) {
  current_data <- wave_list[[wave_index]]
  if (!"ID" %in% names(current_data)) stop("T", wave_index, " missing ID.")
  missing_items <- setdiff(required_items, names(current_data))
  if (length(missing_items) > 0) stop("T", wave_index, " missing items: ", paste(missing_items, collapse = ", "))
  current_data$ID <- trimws(as.character(current_data$ID))
  for (item_name in required_items) current_data[[item_name]] <- to_numeric_safe(current_data[[item_name]])
  wave_list[[wave_index]] <- current_data
}

# ==============================================================================
# 5. BASELINE SPECIFIC SLEEP COMPLAINT STRATIFICATION (T1)
# ==============================================================================
t1_data <- wave_list$T1
t1_sleep_matrix <- as.matrix(t1_data[, sleep_items, drop = FALSE])
t1_missing_sleep <- rowSums(is.na(t1_sleep_matrix)) > 0
cat("Participants excluded due to missing T1 sleep items: N =", sum(t1_missing_sleep), "\n")

t1_valid_sleep <- t1_data[!t1_missing_sleep, , drop = FALSE]

s44 <- as.integer(t1_valid_sleep[[sleep_items[1]]] >= 1)
s64 <- as.integer(t1_valid_sleep[[sleep_items[2]]] >= 1)
s66 <- as.integer(t1_valid_sleep[[sleep_items[3]]] >= 1)
sleep_count <- s44 + s64 + s66

t1_group_vector <- case_when(
  sleep_count == 0             ~ "No complaint",
  sleep_count == 1 & s44 == 1L ~ "Difficulty falling asleep only",
  sleep_count == 1 & s64 == 1L ~ "Early awakening only",
  sleep_count == 1 & s66 == 1L ~ "Superficial sleep only",
  sleep_count >= 2             ~ "Multiple complaints",
  TRUE                         ~ NA_character_
)

t1_group_assignment <- tibble(
  ID = t1_valid_sleep$ID,
  SleepGroup = factor(t1_group_vector, levels = five_group_levels)
)

group_sizes <- t1_group_assignment %>% count(SleepGroup, name = "Baseline_N")
write.csv(group_sizes, file.path(output_dir, "Exploratory_sleep_baseline_group_sizes.csv"), row.names = FALSE)
cat("\nT1 Five Sleep Phenotype Sample Sizes:\n")
print(group_sizes)

# ==============================================================================
# 6. ASSEMBLE LONGITUDINAL DATASET
# ==============================================================================
long_records <- list()
for (wave_index in seq_along(wave_list)) {
  curr <- wave_list[[wave_index]] %>%
    inner_join(t1_group_assignment, by = "ID") %>%
    mutate(
      time = wave_index,
      across(all_of(c(dep_items, anx_items)), ~ ifelse(.x >= 1, 1L, -1L))
    )
  long_records[[wave_index]] <- curr
}
all_waves_long <- bind_rows(long_records)

# ==============================================================================
# 7. LOAD EMPIRICAL SPARSE TOPOLOGIES
# ==============================================================================
dep_pattern_path <- file.path(pattern_dir, "DEP_selected_omega_pattern.rds")
anx_pattern_path <- file.path(pattern_dir, "ANX_selected_omega_pattern.rds")

if (!file.exists(dep_pattern_path) || !file.exists(anx_pattern_path)) {
  stop("Precomputed network topology pattern RDS files not found in: ", pattern_dir)
}

dep_pattern <- readRDS(dep_pattern_path)
anx_pattern <- readRDS(anx_pattern_path)

cat("Depression topology free edges: ", edge_count(dep_pattern), "\n")
cat("Anxiety topology free edges:    ", edge_count(anx_pattern), "\n")

# ==============================================================================
# 8. FIT STRATIFIED ISING MODELS & ESTIMATE TEMPERATURES
# ==============================================================================
dep_group_models <- list()
anx_group_models <- list()

for (g in five_group_levels) {
  grp_data <- all_waves_long %>% filter(SleepGroup == g)
  dep_group_models[[g]] <- fit_group_model(grp_data, dep_items, dep_pattern, "Depression", g)
  anx_group_models[[g]] <- fit_group_model(grp_data, anx_items, anx_pattern, "Anxiety", g)
}

saveRDS(dep_group_models, file.path(output_dir, "Exploratory_sleep_DEP_group_models.rds"))
saveRDS(anx_group_models, file.path(output_dir, "Exploratory_sleep_ANX_group_models.rds"))

dep_point <- extract_group_temperature(dep_group_models, "Depression")
anx_point <- extract_group_temperature(anx_group_models, "Anxiety")
all_point <- bind_rows(dep_point, anx_point)
write.csv(all_point, file.path(output_dir, "Exploratory_sleep_temperature_point_estimates.csv"), row.names = FALSE)

cat("\nFive-Phenotype Temperature Estimates:\n")
print(all_point)

# ==============================================================================
# 9. STRATIFIED ID BOOTSTRAP INFERENCE
# ==============================================================================
dep_boot <- run_stratified_bootstrap(all_waves_long, dep_items, dep_pattern, "Depression", output_dir,
                                    R = BOOT_R, ncores = BOOT_CORES, seed = SEED_DEP, batch_size = BOOT_BATCH_SIZE)
anx_boot <- run_stratified_bootstrap(all_waves_long, anx_items, anx_pattern, "Anxiety", output_dir,
                                    R = BOOT_R, ncores = BOOT_CORES, seed = SEED_ANX, batch_size = BOOT_BATCH_SIZE)

dep_ci <- summarize_group_bootstrap_ci(dep_point, dep_boot)
anx_ci <- summarize_group_bootstrap_ci(anx_point, anx_boot)
all_ci <- bind_rows(dep_ci, anx_ci)
write.csv(all_ci, file.path(output_dir, "Exploratory_sleep_group_temperature_bootstrap_CI.csv"), row.names = FALSE)

# ==============================================================================
# 10. PRIMARY T5 CONTRASTS (BH-FDR ADJUSTMENT) & WAVE-SPECIFIC DELTA-DELTA-T
# ==============================================================================
dep_dd_all <- calculate_delta_delta_table(dep_point, dep_boot, "Depression", wave_focus = paste0("T", 2:5))
anx_dd_all <- calculate_delta_delta_table(anx_point, anx_boot, "Anxiety", wave_focus = paste0("T", 2:5))
all_dd <- bind_rows(dep_dd_all, anx_dd_all)
write.csv(all_dd, file.path(output_dir, "Exploratory_sleep_all_wave_DeltaDeltaT_raw.csv"), row.names = FALSE)

# Focus on T5 with Benjamini-Hochberg FDR correction (4 tests per symptom domain)
exploratory_t5 <- all_dd %>%
  filter(Wave == "T5") %>%
  group_by(Domain) %>%
  mutate(
    FDR_p           = p.adjust(Raw_bootstrap_p, method = "BH"),
    Significant_FDR = !is.na(FDR_p) & (FDR_p < 0.05)
  ) %>%
  ungroup()
write.csv(exploratory_t5, file.path(output_dir, "Exploratory_sleep_T1_T5_DeltaDeltaT_FDR.csv"), row.names = FALSE)

# Intermediate waves (T2-T4)
supp_t2_t4 <- all_dd %>% filter(Wave %in% c("T2", "T3", "T4"))
write.csv(supp_t2_t4, file.path(output_dir, "Exploratory_sleep_T2_T4_DeltaDeltaT.csv"), row.names = FALSE)

# Divergence trajectory summary
divergence_summary <- diagnose_divergence(all_dd)
write.csv(divergence_summary, file.path(output_dir, "Exploratory_sleep_divergence_summary.csv"), row.names = FALSE)

# Publication inference table at T5
no_comp_t5 <- all_point %>%
  filter(SleepGroup == "No complaint", Wave == "T5") %>%
  select(Domain, No_complaint_T5 = Temperature)

t5_inference_table <- exploratory_t5 %>%
  left_join(no_comp_t5, by = "Domain") %>%
  left_join(
    all_point %>% filter(Wave == "T5") %>% select(Domain, FocalGroup = SleepGroup, T5_Temperature = Temperature),
    by = c("Domain", "FocalGroup")
  ) %>%
  transmute(
    Domain,
    Comparison,
    SleepGroup           = FocalGroup,
    No_complaint_T5,
    T5_Temperature,
    DeltaDeltaT,
    Bootstrap_SE,
    CI_lower,
    CI_upper,
    Raw_bootstrap_p,
    FDR_p,
    Significant_FDR,
    Successful_bootstrap,
    Direction = ifelse(DeltaDeltaT < 0, "Lower relative temperature", "Higher relative temperature")
  )
write.csv(t5_inference_table, file.path(output_dir, "Exploratory_sleep_T5_inference_table.csv"), row.names = FALSE)

