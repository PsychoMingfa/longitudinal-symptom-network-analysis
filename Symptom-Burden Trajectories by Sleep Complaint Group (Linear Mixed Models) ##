format_f_report <- function(F_vals) {
  paste0("F(", sprintf("%.1f", F_vals$numerator_df), ", ", sprintf("%.1f", F_vals$denominator_df), ")=",
         sprintf("%.2f", F_vals$F_value), ", p", format_p(F_vals$p_value))
}

format_change_report <- function(row) {
  sign_char <- ifelse(row$estimate >= 0, "+", "")
  paste0(sign_char, sprintf("%.3f", row$estimate), " (95% CI ", sprintf("%.3f", row$lower.CL), " to ",
         sprintf("%.3f", row$upper.CL), ", p", format_p(row$p.value), ")")
}

dep_f_vals <- get_F_values(dep_results$interaction_F)
anx_f_vals <- get_F_values(anx_results$interaction_F)

dep_means_vec <- split(dep_results$adjusted_means$emmean, dep_results$adjusted_means$SleepGroup)
anx_means_vec <- split(anx_results$adjusted_means$emmean, anx_results$adjusted_means$SleepGroup)

dep_t5_t1 <- dep_results$within_group %>% filter(contrast == "T5 - T1")
anx_t5_t1 <- anx_results$within_group %>% filter(contrast == "T5 - T1")

dep_t5_contrast <- dep_results$T5_contrasts %>% filter(contrast == "Multiple complaints - No complaint")
anx_t5_contrast <- anx_results$T5_contrasts %>% filter(contrast == "Multiple complaints - No complaint")

result_text_3_7 <- paste0(
  "Results 3.7 Symptom-burden trajectories by sleep group:\n\n",
  "Random-intercept linear mixed-effects models included ", nrow(dep_results$model_data),
  " observations for depression and ", nrow(anx_results$model_data),
  " observations for anxiety, adjusting for baseline age and sex.\n\n",
  "For depression symptom burden, there was a significant Wave x SleepGroup interaction, ",
  format_f_report(dep_f_vals), ". ",
  "Estimated marginal means (T1-T5) were: ",
  "No complaint = ", paste(sprintf("%.3f", dep_means_vec[["No complaint"]]), collapse = ", "), "; ",
  "Single complaint = ", paste(sprintf("%.3f", dep_means_vec[["Single complaint"]]), collapse = ", "), "; ",
  "Multiple complaints = ", paste(sprintf("%.3f", dep_means_vec[["Multiple complaints"]]), collapse = ", "), ". ",
  "Within-group changes from T1 to T5: ",
  "No complaint group, ", format_change_report(dep_t5_t1 %>% filter(SleepGroup == "No complaint")), "; ",
  "Single complaint group, ", format_change_report(dep_t5_t1 %>% filter(SleepGroup == "Single complaint")), "; ",
  "Multiple complaints group, ", format_change_report(dep_t5_t1 %>% filter(SleepGroup == "Multiple complaints")), ". ",
  "At T5, participants with multiple complaints exhibited higher symptom burden than those with no complaints, difference = ",
  format_change_report(dep_t5_contrast), ".\n\n",
  "For anxiety symptom burden, there was also a significant Wave x SleepGroup interaction, ",
  format_f_report(anx_f_vals), ". ",
  "Estimated marginal means (T1-T5) were: ",
  "No complaint = ", paste(sprintf("%.3f", anx_means_vec[["No complaint"]]), collapse = ", "), "; ",
  "Single complaint = ", paste(sprintf("%.3f", anx_means_vec[["Single complaint"]]), collapse = ", "), "; ",
  "Multiple complaints = ", paste(sprintf("%.3f", anx_means_vec[["Multiple complaints"]]), collapse = ", "), ". ",
  "Within-group changes from T1 to T5: ",
  "No complaint group, ", format_change_report(anx_t5_t1 %>% filter(SleepGroup == "No complaint")), "; ",
  "Single complaint group, ", format_change_report(anx_t5_t1 %>% filter(SleepGroup == "Single complaint")), "; ",
  "Multiple complaints group, ", format_change_report(anx_t5_t1 %>% filter(SleepGroup == "Multiple complaints")), ". ",
  "At T5, participants with multiple complaints exhibited higher symptom burden than those with no complaints, difference = ",
  format_change_report(anx_t5_contrast), ".\n"
)

writeLines(result_text_3_7, file.path(output_dir, "Symptom_burden_Results_3_7_text.txt"))
cat("\n", result_text_3_7, "\n", sep = "")
message("Symptom-burden LMM analysis completed successfully. Output saved to: ", output_dir)
