  anx_results$interaction_F %>% mutate(Domain = "Anxiety")
)
write.csv(all_interaction_F, file.path(output_dir, "Symptom_burden_interaction_F_tests.csv"), row.names = FALSE)

all_adjusted_means <- bind_rows(dep_results$adjusted_means, anx_results$adjusted_means)
write.csv(all_adjusted_means, file.path(output_dir, "Symptom_burden_adjusted_means_long.csv"), row.names = FALSE)

adjusted_table_wide <- all_adjusted_means %>%
  select(Domain, SleepGroup, Wave, Cell) %>%
  pivot_wider(names_from = Wave, values_from = Cell)
write.csv(adjusted_table_wide, file.path(output_dir, "Symptom_burden_adjusted_means_table.csv"), row.names = FALSE)

all_within <- bind_rows(dep_results$within_group, anx_results$within_group)
write.csv(all_within, file.path(output_dir, "Symptom_burden_within_group_changes.csv"), row.names = FALSE)

all_t5_contrasts <- bind_rows(dep_results$T5_contrasts, anx_results$T5_contrasts)
write.csv(all_t5_contrasts, file.path(output_dir, "Symptom_burden_T5_group_contrasts.csv"), row.names = FALSE)

all_diagnostics <- bind_rows(dep_results$diagnostics, anx_results$diagnostics)
write.csv(all_diagnostics, file.path(output_dir, "Symptom_burden_model_diagnostics.csv"), row.names = FALSE)

